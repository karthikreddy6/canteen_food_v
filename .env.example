# Deployment mode: "development" | "production"
ENVIRONMENT=production

# Database (PostgreSQL Asyncpg)
DATABASE_URL=postgresql+asyncpg://BUVVA:BUVA%40KR@localhost:5432/onfood

# JWT Authentication
JWT_SECRET=your_32_character_jwt_secret_here
JWT_ISSUER=onfood

# OTP hashing
OTP_HASH_SECRET=your_otp_hash_secret_here

# WhatsApp bot
WHATSAPP_BOT_INTERNAL_KEY=your_whatsapp_bot_key_here
WHATSAPP_BOT_URL=http://host.docker.internal:3000

# CORS
CORS_ALLOWED_ORIGINS=["https://api1.krtech.online"]

# Trusted reverse proxy IPs
TRUSTED_PROXY_IPS=["127.0.0.1"]

# App client identity guard
APP_CLIENT_KEY=ONFOOD_SECURE_CLIENT_APP_KEY_2026
APP_CLIENT_KEY_HEADER=X-App-Key

# Feature flags & Swagger docs
ENABLE_DOCS=false

# Cloudflare Tunnel Token
CLOUDFLARE_TUNNEL_TOKEN=

# Zoho SMTP Email
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_EMAIL=your_email@domain.com
SMTP_PASSWORD=your_password
SMTP_FROM_NAME=OnFood

# Firebase Admin SDK & Cloud Firestore
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIRESTORE_MONGO_URI=mongodb://server:...@...firestore.goog:443/default?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
