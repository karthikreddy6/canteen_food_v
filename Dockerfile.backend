FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install system dependencies (gosu for dropping privileges)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    gosu \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Copy application source
COPY . .

# Create logs directory
RUN mkdir -p /app/logs

# Create a non-root user for security
RUN groupadd -r onfood && useradd -r -g onfood -d /app -s /sbin/nologin onfood \
    && chown -R onfood:onfood /app

# Make entrypoint executable
RUN chmod +x /app/entrypoint.sh

# Expose server port
EXPOSE 8000

# Entrypoint fixes volume permissions then drops to onfood user
ENTRYPOINT ["/app/entrypoint.sh"]
